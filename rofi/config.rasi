configuration {
    modes: "window,drun,run,ssh";
    font: "Hack 10";
    show-icons: true;
    combi-modes: "window,run";
    click-to-exit: true;
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@theme "Arc-Dark"
@import "Arc-Dark.rasinc"
